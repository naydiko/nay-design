# NayDesign local/CI defaults. Copy to `.env` for local Docker runs.
# These values are safe placeholders for development and CI only.

POSTGRES_DB=udesign
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Development/CI signing key only. Use a real secret in any deployed environment.
JWT_SECRET=change-me-local-ci-jwt-secret-at-least-32-characters-long

FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Leave blank unless Google Sign-In is configured for a local development app.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Baked into the Docker-built frontend bundle.
VITE_API_BASE_URL=http://localhost:8080
