# Copy this file to .env and adjust values as needed. .env is git-ignored;
# this example file is the only one committed to version control.
# Used by /docker-compose.yml (Mode A — full Docker environment).

# ---------- PostgreSQL ----------
POSTGRES_DB=udesign
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port PostgreSQL is published on (containers always use 5432 internally).
POSTGRES_PORT=5433

# ---------- Backend ----------
# Host port the backend API is published on.
BACKEND_PORT=8080
# Required in every environment except the backend's "local" profile.
# Generate your own for anything beyond local development, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-dev-only-secret-key-please-32-bytes-min
# Origin of the frontend, used to build password-reset / email-verification links.
FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Google OAuth 2.0 Web Client ID (Google Cloud Console). Leave blank to
# disable "Continue with Google" — POST /api/auth/google will return a
# clear 500 instead of silently trusting an unverified identity.
GOOGLE_CLIENT_ID=

# ---------- Frontend ----------
# Host port the frontend is published on (full Docker mode only).
FRONTEND_PORT=3000
# Baked into the frontend bundle at build time — must point to wherever the
# *browser* can reach the backend (not the Docker service name).
VITE_API_BASE_URL=http://localhost:8080
# Same Google Client ID as above; must match GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

